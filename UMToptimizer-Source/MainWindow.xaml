<Window x:Class="UMToptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UMToptimizer" Icon="/Assets/UMToptimizer.ico" Width="1180" Height="740" MinWidth="920" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent">
    <Border x:Name="Shell" Background="{StaticResource Bg}" BorderBrush="#343839" BorderThickness="1" CornerRadius="17" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#151718" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#A8C9B4" Margin="0,0,7,0"/><Ellipse Width="8" Height="8" Fill="#5E6662" Margin="0,0,7,0"/><Ellipse Width="8" Height="8" Fill="#404644"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="UMTOPT // CONTROL CENTER" Foreground="#8A908D" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="ReadyDot" Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,10,0"/><TextBlock x:Name="HeaderStatus" Text="SİSTEM HAZIR" Foreground="#9BA29E" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="—" Padding="9,2" Margin="12,0,0,0" Click="Minimize_Click"/><Button Content="□" Padding="9,2" Margin="0,0,5,0" Click="Maximize_Click"/><Button Content="×" Padding="9,2" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#141617" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="18,23,16,18" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="UMToptimizer" Foreground="#F2F4F2" FontSize="22" FontWeight="Bold" Margin="4,1,0,28"/>
                            <Button x:Name="OverviewNav" Content="◈   Genel bakış" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Overview_Click"/>
                            <Button x:Name="WindowsNav" Content="◦   Windows" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Windows_Click"/>
                            <Button x:Name="AndroidNav" Content="◦   Android ADB" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Android_Click"/>
                            <Button x:Name="RestoreNav" Content="◦   Geri yükleme" HorizontalContentAlignment="Left" Click="Restore_Click"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="KONTROL SENDE" Foreground="#626966" FontFamily="Consolas" FontSize="10" Margin="4,0,0,6"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1" ClipToBounds="True">
                    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True" Background="Transparent" ScrollChanged="MainScroll_ScrollChanged">
                        <ContentControl x:Name="PageHost" Margin="42,34,42,36"/>
                    </ScrollViewer>
                    <Border x:Name="TopGlassEdge" Height="18" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#6B222827" Offset="0"/><GradientStop Color="#00222827" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <Border x:Name="BottomGlassEdge" Height="24" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00222827" Offset="0"/><GradientStop Color="#7A171A1B" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

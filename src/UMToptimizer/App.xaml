<Application x:Class="UMToptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:UMToptimizer.UI"
             StartupUri="UI/MainWindow.xaml">
    <Application.Resources>
        <!-- Görsel dil: Windows 11 Fluent. Renkler temanın kendi anlamsal anahtarlarından gelir (DynamicResource),
             böylece açık/koyu tema ve yüksek karşıtlık kendiliğinden doğru çalışır; kodda ham renk yoktur. -->
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
        <ui:EqualsConverter x:Key="Eq"/>
        <ui:VisibleConverter x:Key="Vis"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="Warning" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- Kenar çubuğu gezinme öğesi: RadioButton = tek seçim. Klavye odağı için görünür halka korunur. -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border BorderThickness="2" CornerRadius="6" Margin="0,2" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6" Padding="12,9" Margin="0,2" Background="Transparent">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profil kartı (Windows ve Android listeleri aynı şablonu paylaşır) -->
        <DataTemplate x:Key="ProfileItem">
            <Grid Margin="4,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Seçili profilin başlığı + risk uyarısı -->
        <DataTemplate x:Key="ProfileHeader">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="22"/>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Warning}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="18" Margin="0,1,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Dikkat" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Risk}" Style="{StaticResource Body}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Application.Resources>
</Application>

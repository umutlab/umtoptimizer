<Window x:Class="UMToptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UMToptimizer" Icon="Assets/UMToptimizer.ico"
        Width="1160" Height="800" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Seçili profilin ayrıntısı: Windows ve Android sayfaları aynı bloğu kullanır -->
        <DataTemplate x:Key="ProfileHeader">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="22"/>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Warning}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="18" Margin="0,1,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Dikkat" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Risk}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ================= Kenar çubuğu ================= -->
        <DockPanel Margin="12,18,4,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,24">
                    <Image Source="Assets/UMToptimizer.ico" Width="28" Height="28"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="UMToptimizer" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Kontrol sende" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Genel bakış" ToolTip="Ctrl+1" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavWindows" Style="{StaticResource Nav}" Tag="&#xE770;" Content="Windows" ToolTip="Ctrl+2" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavAndroid" Style="{StaticResource Nav}" Tag="&#xE8EA;" Content="Android (ADB)" ToolTip="Ctrl+3" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavRestore" Style="{StaticResource Nav}" Tag="&#xE777;" Content="Geri yükleme" ToolTip="Ctrl+4" Checked="Nav_Checked"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Margin="0" VerticalAlignment="Bottom">
                <DockPanel>
                    <Ellipse x:Name="AdbDot" Width="8" Height="8" Margin="0,5,10,0" VerticalAlignment="Top" Fill="Gray"/>
                    <StackPanel>
                        <TextBlock x:Name="AdbStatus" AutomationProperties.LiveSetting="Polite" Text="ADB aranıyor…" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AdbDetail" Style="{StaticResource Muted}" FontSize="11" LineHeight="16"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ================= İçerik ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Pages">
                <!-- Genel bakış -->
                <ScrollViewer x:Name="HomePage">
                    <StackPanel Margin="32,28,32,16">
                        <TextBlock Text="Genel bakış" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,22"
                                   Text="Bir profil seç, neyi değiştireceğini incele, uygula. Her uygulamadan önce otomatik yedek alınır; beğenmezsen Geri yükleme'den dönebilirsin."/>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="&#xE770;" FontFamily="{StaticResource Icons}" FontSize="24" Margin="0,0,0,10"/>
                                    <TextBlock Text="Windows" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="HomeWindows" Style="{StaticResource Muted}" MinHeight="40"/>
                                    <Button Content="Profilleri aç" Margin="0,12,0,0" Click="Go_Click" Tag="NavWindows"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="24" Margin="0,0,0,10"/>
                                    <TextBlock Text="Android ADB" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="HomeAdb" Style="{StaticResource Muted}" MinHeight="40"/>
                                    <Button Content="Cihaz profilleri" Margin="0,12,0,0" Click="Go_Click" Tag="NavAndroid"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="24" Margin="0,0,0,10"/>
                                    <TextBlock Text="Yedekler" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="HomeBackups" Style="{StaticResource Muted}" MinHeight="40"/>
                                    <Button Content="Geri yükleme" Margin="0,12,0,0" Click="Go_Click" Tag="NavRestore"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Nasıl çalışır?" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    1.  Windows veya Android sayfasında profili seç; açıklama, riskler ve (Android'de) tüm komutlar görünür.<LineBreak/>
                                    2.  Uygula'ya bas. Windows için yönetici izni istenir; Android için USB hata ayıklama açık olmalı.<LineBreak/>
                                    3.  Uygulama öncesi değerler kaydedilir. Geri yükleme sayfasından tek tıkla eski hâline dönebilirsin.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Windows -->
                <Grid x:Name="WindowsPage" Margin="32,28,32,12" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Windows" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Gömülü PowerShell betiği yönetici izniyle arka planda çalışır; ilerleme aşağıdaki işlem panelinde görünür."/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <ListBox x:Name="WinProfiles" AutomationProperties.Name="Windows profilleri" ItemTemplate="{StaticResource ProfileItem}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0"/>
                        <ScrollViewer Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=WinProfiles}">
                            <StackPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileHeader}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Neler değişir?" Style="{StaticResource H2}"/>
                                        <ItemsControl ItemsSource="{Binding Highlights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" Margin="0,3,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Seçenekler" Style="{StaticResource H2}"/>
                                        <CheckBox x:Name="OptRestorePoint" IsChecked="True" Content="Önce Sistem Geri Yükleme noktası oluştur (önerilir, birkaç dakika sürebilir)"/>
                                        <CheckBox x:Name="OptBitLocker" Margin="0,6,0,0" Content="BitLocker açıksa kapatılmasına izin ver — kurtarma anahtarımı yedekledim"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="WinApply" Content="Profili uygula" Style="{DynamicResource AccentButtonStyle}"
                                        HorizontalAlignment="Right" Padding="28,8" Margin="0,4,0,8" Click="WinApply_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Android -->
                <Grid x:Name="AndroidPage" Margin="32,28,32,12" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Android (ADB)" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Cihaz takılınca otomatik algılanır. Profil tek bir ADB oturumunda çalışır; değişen ayarların ilk değerleri yedeklenir."/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="InstallAdb" Content="ADB'yi indir" Margin="8,0,0,0" Click="InstallAdb_Click" Style="{DynamicResource AccentButtonStyle}"/>
                                    <Button Content="adb.exe seç" Margin="8,0,0,0" Click="PickAdb_Click"/>
                                </StackPanel>
                                <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="Devices" AutomationProperties.Name="Android cihaz" DisplayMemberPath="Display" HorizontalAlignment="Stretch"/>
                            </DockPanel>
                            <TextBlock x:Name="DeviceHint" Style="{StaticResource Muted}" Margin="32,8,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <ListBox x:Name="AndroidProfiles" AutomationProperties.Name="Android profilleri" ItemTemplate="{StaticResource ProfileItem}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0"/>
                        <ScrollViewer Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=AndroidProfiles}">
                            <StackPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileHeader}"/>
                                <Expander Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBlock><Run Text="Tüm komutları göster"/><Run Text="  ·  " Foreground="Gray"/><Run Text="{Binding Badge, Mode=OneWay}" Foreground="Gray"/></TextBlock>
                                    </Expander.Header>
                                    <ListBox ItemsSource="{Binding Commands}" MaxHeight="320" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                </Expander>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,8">
                                    <Button x:Name="Reboot" Content="Cihazı yeniden başlat" Padding="18,8" Margin="0,0,8,0" Click="Reboot_Click"/>
                                    <Button x:Name="AndroidApply" Content="Profili uygula" Style="{DynamicResource AccentButtonStyle}" Padding="28,8" Click="AndroidApply_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Geri yükleme -->
                <ScrollViewer x:Name="RestorePage" Visibility="Collapsed">
                    <StackPanel Margin="32,28,32,16">
                        <TextBlock Text="Geri yükleme" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,22"
                                   Text="Yedekler ilk uygulamadan önceki (orijinal) değerleri tutar; art arda profil uygulasan da ilk hâline döner."/>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button x:Name="RestoreWin" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Windows'u geri yükle" Click="RestoreWin_Click"/>
                                <TextBlock Text="&#xE770;" FontFamily="{StaticResource Icons}" FontSize="22" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="Windows" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="RestoreWinText" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="RestoreAndroid" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Seçili cihazı geri yükle" Click="RestoreAndroid_Click"/>
                                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="22" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="Android cihazlar" Style="{StaticResource H2}"/>
                                        <TextBlock Style="{StaticResource Muted}" Text="Geri yüklemek için cihaz bağlı ve yetkili olmalı. Derleme gibi bazı komutlar geri alınamaz."/>
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="Snapshots" Margin="36,12,0,0" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <TextBlock Text="{Binding Serial}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="NoSnapshots" Text="Kayıtlı Android yedeği yok." Style="{StaticResource Muted}" Margin="36,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= İşlem paneli (tüm sayfalarda ortak) ================= -->
            <Border x:Name="Activity" Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,16" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource Icons}" Padding="8,4" Margin="6,0,0,0" ToolTip="Gizle" AutomationProperties.Name="İşlem panelini gizle" Click="HideActivity_Click"/>
                        <Button DockPanel.Dock="Right" Content="Günlükler" Padding="10,4" Click="OpenLogs_Click"/>
                        <TextBlock x:Name="ActivityTitle" AutomationProperties.LiveSetting="Polite" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="4" Margin="0,10,0,10"/>
                    <TextBox x:Name="LogBox" AutomationProperties.Name="İşlem günlüğü" Height="170" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
